# S1 localhost DEMO. Copiar opcionalmente a .env; no contiene secretos.
APP_ENV=development
DATA_ORIGIN=DEMO
REAL_MODE_ENABLED=false
TZ=UTC
DISPLAY_TIMEZONE=America/Lima
ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173
WEB_PORT=15173
API_PORT=18000
DB_PORT=55432
S1_SECRETS_DIR=./.local/secrets
# infra/prepare_demo.py genera contraseñas independientes, URLs y secreto CSRF.
# Compose monta archivos secretos; la API no recibe credenciales del propietario.
SESSION_COOKIE_SECURE=false
# Importaciones y modelos no implementados en S1; rutas externas en fases siguientes.
IMPORT_STORAGE_DIR=
MODEL_STORAGE_DIR=
